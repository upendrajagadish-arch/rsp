# Supabase (local: run `npx supabase start` and copy keys from its output)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Worker auth for /api/jobs/process
JOB_WORKER_SECRET=change-me-in-production

# Optional OCR / AI extraction (leave empty to surface Extraction Unavailable)
OCR_PROVIDER=
OCR_API_KEY=
OPENAI_API_KEY=

# Optional issuer verification adapters
CREDENTIAL_NET_API_KEY=
GOOGLE_CREDENTIALS_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
